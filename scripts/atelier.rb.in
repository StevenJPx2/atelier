# Generated by atelier's scripts/release.py; do not edit by hand.
class Atelier < Formula
  desc "Personal software factory driven by labelled issues"
  homepage "$repository"
  license "MIT"

$platforms

  def install
    bin.install "bin/atelier"
    pkgshare.install "share/atelier/LICENSE"
  end

  def caveats
    "The issue loop and daemon are planned for slice 1; do not start the service yet."
  end

  service do
    run [opt_bin/"atelier", "daemon"]
    keep_alive true
    environment_variables PATH: std_service_path_env
    log_path var/"log/atelier.log"
    error_log_path var/"log/atelier.log"
  end

  test do
    assert_match "atelier #{version}", shell_output("#{bin}/atelier --version")
  end
end
